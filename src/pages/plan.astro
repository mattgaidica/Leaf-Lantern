  }

  .chart-fill {
    height: 100%;
    border-radius: 999px;
    min-width: 8px;
  }

  .chart-value {
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    opacity: 0.85;
  }

  /* ---------- Break-even chart ---------- */
  .be-chart {
    position: relative;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.6rem 1.5rem 1.3rem;
    margin-block: 1.4rem 0.6rem;
  }

  .be-plot {
    position: relative;
    height: 320px;
    margin: 1.6rem 0.5rem 3.1rem 3.2rem;
  }

  .be-grid {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px dashed var(--line);
  }

  .be-grid span {
    position: absolute;
    left: -3.2rem;
    top: -0.6em;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .be-band {
    position: absolute;
    left: 0;
    right: 0;
    background: color-mix(in srgb, var(--cider) 14%, transparent);
    border-top: 2px dashed var(--cider);
    border-bottom: 2px dashed var(--cider);
  }

  .be-band span {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    background: var(--parchment);
    border: 1px solid color-mix(in srgb, var(--cider) 45%, transparent);
    border-radius: 999px;
    padding: 0.18rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cider);
    white-space: nowrap;
  }

  .be-cols {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 6vw, 4rem);
    padding-inline: clamp(0.5rem, 4vw, 2.5rem);
  }

  .be-col {
    position: relative;
    height: 100%;
  }

  .be-stack {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column-reverse;
  }

  .be-seg {
    width: 100%;
    transition: opacity 120ms ease;
    cursor: default;
  }

  .be-stack:hover .be-seg {
    opacity: 0.45;
  }

  .be-stack .be-seg:hover {
    opacity: 1;
  }

  .be-seg:first-child {
    border-radius: 0 0 4px 4px;
  }

  .be-seg:last-child {
    border-radius: 4px 4px 0 0;
  }

  .be-total {
    position: absolute;
    left: 50%;
    transform: translate(-50%, -0.4rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--deep-pine);
    white-space: nowrap;
    z-index: 2;
    background: var(--white);
    border-radius: 999px;
    padding: 0 0.4rem;
  }

  .be-year {
    position: absolute;
    left: 50%;
    bottom: -2.9rem;
    transform: translateX(-50%);
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    text-align: center;
  }

  .be-year small {
    display: block;
    font-weight: 400;
    font-size: 0.72rem;
    opacity: 0.65;
  }

  .be-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin-top: 0.6rem;
  }

  .be-key {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    opacity: 0.85;
  }

  .be-key i {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .be-tooltip {
    position: absolute;
    z-index: 5;
    pointer-events: none;
    background: var(--lantern-black);
    color: var(--parchment);
    border-radius: var(--radius);
    padding: 0.5rem 0.7rem;
    font-size: 0.8rem;
    line-height: 1.4;
    box-shadow: var(--shadow-soft);
    max-width: 240px;
  }

  .be-tooltip :global(strong) {
    display: block;
    color: var(--wheat);
  }

  /* ---------- Investor payback chart ---------- */
  .pb-chart {
    position: relative;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.6rem 1.5rem 1.3rem;
    margin-block: 1.4rem 0.6rem;
  }

  .pb-plot {
    position: relative;
    height: 280px;
    margin: 2.2rem 0.5rem 2.2rem 0.5rem;
  }

  .pb-line {
    position: absolute;
    left: 0;
    right: 0;
  }

  .pb-zero {
    border-top: 1px solid var(--line);
  }

  .pb-zero span {
    position: absolute;
    left: 0;
    top: -0.6em;
    transform: translateX(-0.1rem);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
    background: var(--white);
    padding-right: 0.3rem;
  }

  .pb-equity {
    border-top: 2px dashed var(--cider);
    z-index: 3;
  }

  .pb-equity span {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    background: var(--parchment);
    border: 1px solid color-mix(in srgb, var(--cider) 45%, transparent);
    border-radius: 999px;
    padding: 0.18rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cider);
    white-space: nowrap;
  }

  .pb-cols {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: clamp(0.5rem, 2.5vw, 1.4rem);
    padding-inline: clamp(0.25rem, 2vw, 1.25rem);
  }

  .pb-col {
    position: relative;
    height: 100%;
  }

  .pb-bar {
    position: absolute;
    left: 0;
    right: 0;
    background: var(--deep-pine);
    border-radius: 4px 4px 0 0;
    min-height: 2px;
  }

  .pb-bar.pb-neg {
    background: var(--cranberry);
    border-radius: 0 0 4px 4px;
  }

  .pb-val {
    position: absolute;
    left: 50%;
    top: -1.25rem;
    transform: translateX(-50%);
    font-size: 0.7rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--deep-pine);
    white-space: nowrap;
  }

  .pb-bar.pb-neg .pb-val {
    top: auto;
    bottom: -1.25rem;
    color: var(--cranberry);
  }

  .pb-year {
    position: absolute;
    left: 50%;
    bottom: -2rem;
    transform: translateX(-50%);
    font-size: 0.8rem;
    font-weight: 700;
  }

  /* ---------- Positioning strategy maps ---------- */
  .pos-plot {
    margin: 1.8rem 0 2.4rem;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.5rem 1.5rem 1.4rem;
  }

  .pos-head {
    display: flex;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }

  .pos-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cider);
  }

  .pos-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--deep-pine);
  }

  .pos-frame {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6rem;
  }

  .pos-canvas {
    position: relative;
    aspect-ratio: 16 / 10;
    background:
      linear-gradient(to right, transparent calc(50% - 0.5px), var(--line) calc(50% - 0.5px), var(--line) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
      linear-gradient(to bottom, transparent calc(50% - 0.5px), var(--line) calc(50% - 0.5px), var(--line) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
      #faf7f0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .pos-axis {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
  }

  .pos-axis-x {
    grid-column: 2;
  }

  .pos-axis-y {
    grid-row: 1;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .pos-axis-title {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--deep-pine);
    text-align: center;
  }

  .pos-end {
    font-style: italic;
    opacity: 0.6;
  }

  .pos-point {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--deep-pine);
    transform: translate(-50%, 50%);
  }

  .pos-point span {
    position: absolute;
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--lantern-black);
    opacity: 0.85;
    width: max-content;
    max-width: 11em;
    text-align: center;
  }

  .pos-top span {
    bottom: calc(100% + 5px);
    left: 50%;
    transform: translateX(-50%);
  }

  .pos-bottom span {
    top: calc(100% + 5px);
    left: 50%;
    transform: translateX(-50%);
  }

  .pos-left span {
    right: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
    text-align: right;
  }

  .pos-right span {
    left: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
    text-align: left;
  }

  .pos-us {
    width: 17px;
    height: 17px;
    background: var(--cider);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--cider) 20%, transparent);
    z-index: 2;
  }

  .pos-us span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--cider);
    opacity: 1;
  }

  .pos-axis-note {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0.9rem 0 0.6rem;
  }

  .pos-mech-note {
    font-size: 0.85rem;
    opacity: 0.8;
    margin: 0 0 0.6rem;
  }

  .pos-takeaway {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--deep-pine);
    border-left: 3px solid var(--cider);
    padding-left: 0.9rem;
    margin: 0.6rem 0 0.4rem;
  }

  .pos-note {
    font-size: 0.88rem;
    opacity: 0.75;
    margin: 0.5rem 0 0;
  }

  /* ---------- Case studies & market vignettes ---------- */
  .case-study {
    margin: 1.4rem 0;
    border: 1px dashed color-mix(in srgb, var(--cider) 55%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--cider) 6%, var(--parchment));
  }

  .case-study + .case-study {
    margin-top: 0.9rem;
  }

  .case-study summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 3rem 1.1rem 1.3rem;
    position: relative;
  }

  .case-study summary::-webkit-details-marker {
    display: none;
  }

  .case-study summary::after {
    content: '+';
    position: absolute;
    right: 1.2rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--cider);
  }

  .case-study[open] summary::after {
    content: '–';
  }

  .case-flag {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cider);
  }

  .case-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--deep-pine);
    line-height: 1.35;
  }

  .case-body {
    padding: 0 1.3rem 1.2rem;
    border-top: 1px dashed color-mix(in srgb, var(--cider) 35%, transparent);
  }

  .case-body > p:first-child,
  .case-body > .table-wrap:first-child,
  .case-body > .competitor-grid:first-child,
  .case-body > .eq-block:first-child {
    margin-top: 1.1rem;
  }

  .case-body .pull-quote {
    margin-bottom: 0.4rem;
  }

  .case-body .competitor-grid {
    margin-bottom: 0.4rem;
  }

  /* ---------- Reuse diagram ---------- */
  .reuse-diagram {
    margin: 1.6rem 0;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.4rem 1.4rem 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-align: center;
  }

  .reuse-programs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
  }

  .reuse-chip {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--deep-pine);
    background: #faf7f0;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    white-space: nowrap;
  }

  .reuse-arrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cider);
  }

  .reuse-core {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.4rem;
    background: var(--deep-pine);
    color: var(--parchment);
    border-radius: 999px;
    padding: 0.6rem 1.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .reuse-excluded {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.2rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--line);
    width: 100%;
  }

  .reuse-x-label {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cranberry);
    margin-right: 0.3rem;
  }

  .reuse-x {
    font-size: 0.8rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--cranberry) 75%, var(--lantern-black));
    text-decoration: line-through;
    opacity: 0.75;
    white-space: nowrap;
  }

  /* ---------- Swatches ---------- */
  .swatch-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.5rem;
    margin-block: 1.4rem 1.8rem;
  }

  .swatch {
    aspect-ratio: 1 / 1.4;
    border-radius: var(--radius);
    display: flex;
    align-items: flex-end;
    padding: 0.5rem;
    box-shadow: var(--shadow-soft);
  }

  .swatch span {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(244, 239, 229, 0.9);
    line-height: 1.2;
  }

  .swatch-light span {
    color: rgba(31, 36, 30, 0.75);
  }

  /* ---------- Roadmap ---------- */
  .roadmap {
    display: grid;
    gap: 0;
    margin-block: 1.8rem;
  }

  .roadmap-phase {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 1.2rem;
    position: relative;
    padding-bottom: 1.8rem;
  }

  .roadmap-phase:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 44px;
    bottom: 0;
    width: 2px;
    background: var(--line);
  }

  .roadmap-marker {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--deep-pine);
    color: var(--parchment);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .roadmap-head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }

  .roadmap-head h3 {
    margin: 0;
  }

  .roadmap-window {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cider);
  }

  .roadmap-content ul {
    margin: 0.3rem 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.25rem;
    font-size: 0.96rem;
  }

  .target-list {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.4rem;
  }

  .scope-note {
    margin-top: 1.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
    font-style: italic;
    opacity: 0.8;
  }

  .source-list {
    padding-left: 1.3rem;
    display: grid;
    gap: 0.55rem;
    font-size: 0.92rem;
    opacity: 0.85;
  }

  /* ---------- Opening price card ---------- */
  .price-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    border-top: 3px solid var(--cider);
    padding: 1.5rem 1.6rem 1.4rem;
    margin-block: 1.2rem 2rem;
  }

  .price-card-kicker {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cider);
    margin-bottom: 1rem;
  }

  .price-card-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .price-card-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .price-card-list li:last-child {
    border-bottom: none;
  }

  .price-card-item {
    font-size: 0.98rem;
  }

  .price-card-amt {
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--deep-pine);
    white-space: nowrap;
  }

  .price-card-cta {
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
  }

  .price-subhead {
    margin: 0 0 0.55rem;
    font-size: 1.2rem;
  }

  .plan-tool-copy {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  /* ---------- Closing CTA ---------- */
  .plan-cta {
    margin-top: 2.5rem;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    border-top: 4px solid var(--cider);
    padding: 2rem;
    text-align: center;
  }

  .plan-cta p {
    max-width: 38em;
    margin-inline: auto;
  }

  .plan-cta-row {
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 1.2rem;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .plan-hero .container,
    .container.plan-layout {
      padding-inline: clamp(1.25rem, 5vw, 2rem);
    }

    .plan-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .plan-toc {
      position: static;
      border-bottom: 1px solid var(--line);
      padding-bottom: 1.4rem;
      min-width: 0;
    }

    .plan-toc ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-left: none;
      gap: 0.2rem 1rem;
    }

    .plan-toc a {
      border-left: none;
      margin-left: 0;
      padding-left: 0;
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .toc-cta {
      display: none;
    }

    .metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .swatch-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .plan-cta {
      padding: 1.5rem 1.2rem;
    }
  }

  @media (max-width: 560px) {
    .plan-hero .container,
    .container.plan-layout {
      padding-inline: 1.35rem;
    }

    .plan-kicker {
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      padding: 0.4rem 0.85rem;
      white-space: normal;
    }

    .plan-toc ol {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .metric-grid {
      grid-template-columns: 1fr;
    }

    .chart-row {
      grid-template-columns: 60px minmax(0, 1fr);
    }

    .chart-value {
      grid-column: 2;
    }

    .be-chart {
      padding: 1.2rem 1rem 1.1rem;
      overflow: hidden;
    }

    .be-plot {
      height: 250px;
      margin: 1.4rem 0.25rem 3.4rem 2.6rem;
    }

    .be-band span {
      font-size: 0.58rem;
      padding: 0.15rem 0.45rem;
      max-width: 100%;
      white-space: normal;
      line-height: 1.25;
      text-align: right;
    }

    .be-cols {
      gap: 0.75rem;
      padding-inline: 0.25rem;
    }

    .be-total {
      font-size: 0.8rem;
    }

    .be-year {
      font-size: 0.75rem;
    }

    .pb-chart {
      padding: 1.2rem 0.9rem 1.1rem;
