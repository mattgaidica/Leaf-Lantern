// Cumulative distributable cash under capital-gated financing. Y1–Y2 draw reserves;
// Y3 (~85k transactions) is approximately cash break-even. Modest positive years after
// that assume the operation holds the mature band — not a promise of eight-season equity recovery.
// Cumulative operating cash (EBITDA − ≈$235K debt service) under the corrected
// management-target case and a capital-gated ~$4.0M all-in stack. The chart shows
// reserve draw through stabilization — not equity payback. Levered IRR, terminal
// value, replacement-capex reserves, and a downside sale case belong in the IM.
const payback = {
  scaleMin: -650,
  scaleMax: 50,
  equity: 0,
  equityLabel: 'Cash break-even · $0 cumulative',
  years: [
    { label: 'Y1', cum: -339 },
    { label: 'Y2', cum: -531 },
    { label: 'Y3', cum: -575 },
    { label: 'Y4', cum: -535 },
    { label: 'Y5', cum: -495 },
    { label: 'Y6', cum: -455 },
    { label: 'Y7', cum: -415 },
    { label: 'Y8', cum: -375 },
  ],
};

const pbSpan = payback.scaleMax - payback.scaleMin;
const pbPct = (v: number) => ((v - payback.scaleMin) / pbSpan) * 100;

const dashboard = [
