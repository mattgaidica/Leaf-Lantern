      { label: 'Amusement / festival farm', x: 78, y: 90, pos: 'bottom' },
      { label: 'Traditional seasonal cider mill', x: 50, y: 76, pos: 'top' },
      { label: 'Coffee shop', x: 25, y: 16, pos: 'top' },
