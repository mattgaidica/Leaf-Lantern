  kicker: string;
  title: string;
  xTitle: string;
  xLow: string;
  xHigh: string;
  yTitle: string;
  yLow: string;
  yHigh: string;
  axisNote: string;
  alt: string;
  points: PlotPoint[];
  mechanisms?: string[];
  takeaway: string;
  note?: string;
};

const positioningPlots: PositioningPlot[] = [
  {
    kicker: 'Map 1 · The primary thesis map',
    title: 'Emotional value × operating repeatability',
    xTitle: 'Repeatability',
    xLow: 'Low',
    xHigh: 'High',
    yTitle: 'Emotional value',
    yLow: 'Low',
    yHigh: 'High',
    axisNote:
