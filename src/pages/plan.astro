      { label: 'Roadside farm stand', x: 48, y: 20, pos: 'bottom' },
      { label: 'Conventional coffee shop', x: 70, y: 46, pos: 'top' },
      { label: 'Chick-fil-A-style QSR', x: 90, y: 40, pos: 'left' },
