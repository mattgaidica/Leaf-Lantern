  { term: 'Retail basket', def: 'One separate or combined retail purchase.' },
  { term: 'Program participant', def: 'One paid camp, school, workshop, or event attendee.' },
  { term: 'Express order', def: 'A transaction with no normal-duration parking stay — drive-up, office, school, or bulk collection.' },
  { term: 'Preorder + stay', def: 'Order placed before arrival; guest parks and dwells normally. Smooths the kitchen; does not create parking capacity.' },
  { term: 'Preorder + leave', def: 'Order placed before arrival; guest collects and exits with short or no normal dwell. Counts toward express/low-dwell capacity.' },
  { term: 'Conversion', def: 'Buying parties divided by eligible arriving parties — parties, never individual guests.' },
];

