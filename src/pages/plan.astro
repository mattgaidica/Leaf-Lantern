    role: 'Drives visitation and brand — the first economic engine',
    treatment: 'Must clear pilot gates on ticket, conversion, and repeat; alone it does not yet cover full opex + debt',
  },
  {
    layer: 'Curated retail and take-home products',
    role: 'Basket expansion on the same traffic',
    treatment: 'Should share staff, storage, and brand; scales with food traffic',
  },
  {
    layer: 'Camps, education, workshops, markets, and programs',
    role: 'Necessary second economic engine — monetizes the rest of the calendar',
    treatment: 'Not ancillary upside. Underwrite with presales and demonstrated booth fees; still never use bespoke events to rescue the model',
  },
];

const unitTerms = [
  { term: 'Guest visit', def: 'One person entering the public property.' },
  { term: 'Arriving party', def: 'One household or group arriving together.' },
  { term: 'Vehicle-party', def: 'One arriving party consuming a parking space.' },
  { term: 'Food order', def: 'One completed food-and-beverage transaction — the unit behind the 55,000 management-target figure.' },
  { term: 'Retail basket', def: 'One separate or combined retail purchase.' },
  { term: 'Program participant', def: 'One paid camp, school, workshop, or event attendee.' },
  { term: 'Express order', def: 'A transaction with no normal-duration parking stay — drive-up, office, school, or bulk collection.' },
  { term: 'Preorder + stay', def: 'Order placed before arrival; guest parks and dwells normally. Smooths the kitchen; does not create parking capacity.' },
  { term: 'Preorder + leave', def: 'Order placed before arrival; guest collects and exits with short or no normal dwell. Counts toward express/low-dwell capacity.' },
  { term: 'Conversion', def: 'Buying parties divided by eligible arriving parties — parties, never individual guests.' },
];

