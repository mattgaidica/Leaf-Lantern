  { variable: 'Camp price', target: '~$355', underwrite: '$325–375 supported range' },
  { variable: 'Retreats / standardized bookings / programs', target: '~90 corporate bookings and ~$400k mature revenue', underwrite: 'Demonstrated pricing and a credible sales pipeline toward at least 50 annual bookings' },
