    metric: 'Same-season repeat visits per identified household',
    def: 'Visits or purchases by loyalty-identified households, cohorted by one, two, three, and four-plus visits',
    why: 'Directly tests the central investment thesis rather than relying on stated intent',
  },
  {
    metric: 'Average food transaction',
    def: 'Gross food and non-alcoholic beverage sales ÷ completed food orders, with median and distribution',
    why: 'Tests the $16–$18 target and reveals whether the average is broad-based or carried by a few bulk orders',
  },
  {
    metric: 'F&B share of revenue and gross profit',
    def: 'F&B revenue and contribution margin ÷ total revenue and total contribution',
    why: 'Shows whether hero food is actually the economic engine',
  },
  {
    metric: 'Party food-conversion rate',
    def: 'On-site parties purchasing food ÷ total eligible on-site parties',
    why: 'Connects guest traffic to monetization and clarifies the free-admission model',
  },
  {
    metric: 'Orders per direct labor hour',
    def: 'Completed food orders ÷ kitchen, counter, pickup, and beverage labor hours',
    why: 'Measures whether transaction growth creates operating leverage',
