const competitors = [
  {
    name: 'Blake Farms',
    model: 'Large multi-season destination: festivals, Funland, U-pick, classes, wellness, artisan markets, a hard-cider arm, and a 30-plus-tap tasting room across four locations and roughly 900 acres. Festival admission $12–$14 with 100–200+ artisans. In 2022 Blake’s absorbed Erwin Orchards in South Lyon — inside Leaf & Lantern’s target corridor — with announced plans for a ~20,000 sq ft tasting room and full-service restaurant, a 400-person outdoor patio, and a ~12,500 sq ft cider-mill expansion.',
    lesson: 'The region’s strongest operator is doubling down on scale, alcohol, and attraction density in this corridor — confirming destination demand while leaving the small-footprint, food-led, alcohol-free position open. Leaf & Lantern does not try to out-Blake Blake’s.',
  },
  {
    name: 'Wiard’s Orchards',
    model: 'Seventh-generation orchard (est. 1837) that layered on a country store and bakery in the 1960s, an “agri-entertainment” complex in the 1980s, and Night Terrors — among Michigan’s largest haunted attractions. Country Fair gate: $18 weekday, $27.50 weekend, $46 season pass, plus a free-access Country Store.',
    lesson: 'Demonstrates strong autumn willingness to pay for bounded experiences — and how season extension can quietly become attraction accumulation. Leaf & Lantern keeps entry free and monetizes food, retail, and ticketed evenings instead of the gate.',
  },
  {
    name: 'Westview Orchards & Winery',
    model: 'Operating since 1813 on 188 acres. Farm market and bakery spring into winter: U-pick, summer farm fun, porch winery, fall activities, private rentals.',
    lesson: 'Shows the value of a steady market-and-food base underneath seasonal programming. Make the kitchen useful even with no event underway.',
  },
  {
    name: 'Erwin Orchards (South Lyon)',
    model: 'A 102-year, four-generation U-pick orchard — 200 acres, 54,000 trees, 25 apple varieties — beloved by generations and still sold in 2022 after a years-long search for a successor: roughly 30% of the land to a homebuilder for 161 homes, the remainder absorbed into Blake’s.',
    lesson: 'Emotional attachment alone did not produce a durable independent business. Affection must convert into unit economics — repeat transactions, margin, and manageable labor — or the land eventually becomes worth more than the operation.',
  },
  {
    name: 'Zingerman’s Cornman Farms',
    model: 'Premium farm event venue in Dexter (~20 minutes from the target corridor): restored 1834 farmhouse and barn on 27 acres, backed by one of Michigan’s most sophisticated food businesses. Open since 2014; closing after October 2026 as revenue fell from a ~$2.7–3M peak to ~$1.4M in 2025 against a ~$2.2M break-even, citing fewer leads, higher costs, operational complexity, and a shift to smaller gatherings.',
    lesson: 'The region’s best-run farm-event operator could not sustain bespoke venue economics even with a powerful brand. Leaf & Lantern excludes weddings, late-night events, and custom production — while allowing standardized private gatherings that reuse the same packages, staff, and hall.',
  },
];

type PlotPoint = {
  label: string;
  x: number; // 0–100, illustrative
  y: number; // 0–100, illustrative
  us?: boolean;
  pos?: 'top' | 'bottom' | 'left' | 'right';
};

