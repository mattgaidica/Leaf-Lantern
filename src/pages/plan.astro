---
import Base from '../layouts/Base.astro';
import BrandImage from '../components/BrandImage.astro';
import { counterMenu, programPricing, retreatPackages } from '../data/menu';
import { url } from '../lib/site';

const priceOf = (item: string) => {
  const row = counterMenu.find((m) => m.item === item);
  if (!row) throw new Error(`Missing counter menu item: ${item}`);
  return row.price;
};

/** Compact hero snapshot for the plan — prices still come from counterMenu. */
const heroPrices = [
  {
    stream: 'Fresh Donut — single / half-dozen / dozen',
    price: `${priceOf('Fresh Donut')} / ${priceOf('Donuts · half-dozen')} / ${priceOf('Donuts · dozen')}`,
  },
  {
    stream: 'Cider — cup / half-gallon / gallon',
    price: `${priceOf('Cider · cup')} / ${priceOf('Cider · half-gallon')} / ${priceOf('Cider · gallon')}`,
  },
  { stream: 'Morning Cup', price: priceOf('Morning Cup') },
  { stream: 'Bundle · dozen + half-gallon', price: priceOf('Bundle · dozen + half-gallon') },
];

