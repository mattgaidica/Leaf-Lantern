// Cumulative operating cash (EBITDA − ≈$165K debt service) under the
// management-target case and a capital-gated ~$2.75M adaptive-reuse stack.
// Y1 is approximately cash-flat; Y2+ compound. Levered IRR, terminal value,
// replacement-capex reserves, and a downside sale case belong in the IM.
const payback = {
  scaleMin: -100,
  scaleMax: 3000,
  equity: 0,
  equityLabel: 'Cash break-even · $0 cumulative',
  years: [
    { label: 'Y1', cum: -17 },
    { label: 'Y2', cum: 208 },
    { label: 'Y3', cum: 646 },
    { label: 'Y4', cum: 1084 },
    { label: 'Y5', cum: 1522 },
    { label: 'Y6', cum: 1960 },
    { label: 'Y7', cum: 2398 },
    { label: 'Y8', cum: 2836 },
  ],
};

const pbSpan = payback.scaleMax - payback.scaleMin;
const pbPct = (v: number) => ((v - payback.scaleMin) / pbSpan) * 100;

const dashboard = [
  {
    metric: 'Same-season repeat visits per identified household',
