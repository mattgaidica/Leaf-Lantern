---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import BrandImage from '../components/BrandImage.astro';

const programs = [
  {
    name: 'Half-Day Retreat',
    price: 'Meeting room · morning food',
    copy: 'Meeting space, coffee, donuts or pastries, cider or seasonal beverages, and basic audiovisual. Optional boxed lunch through an approved partner.',
  },
  {
    name: 'Full-Day Retreat',
    price: 'Exclusive or semi-exclusive use',
    copy: 'Morning food and beverages, Leaf & Lantern snacks and drinks through the day, optional external lunch, afternoon service, and optional outdoor breakout or seasonal activity.',
  },
  {
    name: 'Private Gathering',
    price: 'Fixed time block · fixed package',
    copy: 'Birthdays, showers, family celebrations, club meetings, and small professional receptions — predetermined layouts, attendance limits, food packages, and a fixed closing time.',
  },
];

const includes = [
  'Corporate retreats and leadership meetings',
  'Department, faculty, and nonprofit gatherings',
  'Strategic planning sessions and workshops',
  'Board meetings and professional development days',
  'Standardized private celebrations within set packages',
];

const avoids = [
  'Weddings and large receptions',
  'Late-night events',
  'Custom event production or room transformations',
  'Dedicated event-planning staff',
  'Full-service catering operations',
];
---
<Base title="Retreats & Gatherings" description="Corporate retreats, meetings, and standardized private gatherings at Leaf & Lantern — daytime, purposeful, and built around our own food.">
  <Hero
    compact
    image="/images/courtyard-summer.png"
    imageAlt="Guests gathered at wood tables in the courtyard beside the main hall"
    imageLabel="The Courtyard"
    eyebrow="Retreats & Gatherings"
    title="A working space that happens to be beautiful."
    copy="Corporate retreats, meetings, and standardized private gatherings — daytime, purposeful, and centered on coffee, cider, and donuts from our own counter."
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Purposeful Bookings</span>
        <h2>What the hall is for</h2>
        <p class="lede">
          The property is a high-quality setting for retreats, meetings, and private gatherings
          that fit predefined packages — not a traditional event venue. Bookings stay
          standardized so the same hall, kitchen, and staff can serve many uses without becoming
          a second business.
        </p>
      </div>
      <div class="pkg-grid">
        {programs.map((p) => (
          <div class="pkg-card">
            <h3>{p.name}</h3>
            <p class="pkg-price">{p.price}</p>
            <p>{p.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container split-lists">
      <div>
        <span class="eyebrow">We Welcome</span>
        <h2>Standardized bookings.</h2>
        <ul class="amenities">
          {includes.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <span class="eyebrow">We Don’t Build</span>
        <h2>Bespoke event production.</h2>
        <ul class="amenities amenities-muted">
          {avoids.map((item) => <li>{item}</li>)}
        </ul>
        <p class="policy-note">
          The distinction is not “private events vs. no private events.” It is standardized
          packages vs. custom production. If a booking needs a dedicated planner or a custom menu,
          it is not a Leaf & Lantern booking.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <BrandImage
        src="/images/yoga-morning.jpg"
        alt="The main hall in an open, flexible configuration with morning light"
        ratio="4 / 3"
      />
      <div>
        <span class="eyebrow">Food Policy</span>
        <h2>What we make. What we don’t.</h2>
        <p>
          Leaf & Lantern supplies the products central to its identity — donuts, cider, coffee,
          seasonal baked goods, and simple snacks. We do not operate as a full-service caterer.
        </p>
        <p>
          For meals outside our kitchen, groups may use an approved catering partner, bring
          outside prepared food with a facility fee, or arrange their own delivery while we
          handle the venue, beverages, snacks, setup, and cleanup.
        </p>
        <ul class="amenities">
          <li>Workshop and classroom seating for up to 80</li>
          <li>Coffee, cider, and donut service from our counter</li>
          <li>Basic audiovisual for presentations</li>
          <li>Accessible route throughout; free parking</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-pine">
    <div class="container-narrow" style="text-align: center;">
      <span class="eyebrow">One Hall, Many Uses</span>
      <h2>Weekday retreats. Weekend workshops. Peak-season seating.</h2>
      <p class="lede" style="margin-inline: auto;">
        The same flexible hall supports corporate days, school groups, camps, markets, private
        gatherings, and autumn customer seating — so every square foot earns its keep.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <span class="eyebrow">Start the Conversation</span>
      <h2>Tell us about your group</h2>
      <form class="inquiry-form" action="#" method="post">
        <div class="form-row">
          <div>
            <label for="rp-name">Your name</label>
            <input id="rp-name" type="text" name="name" required />
          </div>
          <div>
            <label for="rp-email">Email</label>
            <input id="rp-email" type="email" name="email" required />
          </div>
        </div>
        <div class="form-row">
          <div>
            <label for="rp-type">Booking type</label>
            <select id="rp-type" name="type">
              <option>Corporate retreat or meeting</option>
              <option>Half-day or full-day workshop</option>
              <option>Private gathering (birthday, shower, celebration)</option>
              <option>School, nonprofit, or club meeting</option>
              <option>Other</option>
            </select>
          </div>
          <div>
            <label for="rp-size">Estimated attendees</label>
            <input id="rp-size" type="text" name="size" placeholder="e.g. 30" />
          </div>
        </div>
        <label for="rp-notes">Anything else?</label>
        <textarea id="rp-notes" name="notes" rows="4" placeholder="Season, weekday preference, and what your group needs…"></textarea>
        <button class="btn btn-primary" type="submit">Submit Inquiry</button>
        <small>Bookings open with our pilot season — this form is a preview.</small>
      </form>
    </div>
  </section>
</Base>

<style>
  .section-head {
    max-width: 52em;
    margin-bottom: 2.2rem;
  }

  .pkg-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .pkg-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.8rem 1.7rem;
  }

  .pkg-price {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--cider);
    margin-bottom: 0.6rem;
  }

  .pkg-card p:last-child {
    margin: 0;
    font-size: 0.96rem;
  }

  .split-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .policy-note {
    margin-top: 1.2rem;
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .split {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .amenities {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 0.45rem;
  }

  .amenities li {
    padding-left: 1.4rem;
    position: relative;
  }

  .amenities li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cider);
  }

  .amenities-muted li::before {
    background: var(--line);
  }

  .inquiry-form {
    margin-top: 1.4rem;
    display: grid;
    gap: 1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .inquiry-form .btn {
    justify-self: start;
  }

  .inquiry-form small {
    opacity: 0.65;
  }

  @media (max-width: 900px) {
    .pkg-grid,
    .split,
    .split-lists,
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
