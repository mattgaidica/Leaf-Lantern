---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import BrandImage from '../components/BrandImage.astro';

const programs = [
  {
    name: 'Corporate Retreats & Seminars',
    price: '$70 – $140 per attendee',
    copy: 'Weekday, daytime offsites that actually feel different: workshops, planning days, and team mornings with coffee, cider, and donuts from our own counter.',
  },
  {
    name: 'Team Workshops',
    price: '$35 – $85 per person',
    copy: 'Guided wreath building, garden sessions, and craft workshops led by our instructors — a working activity, not a party package.',
  },
  {
    name: 'School & Scout Groups',
    price: '$12 – $16 per student',
    copy: 'Curriculum-mapped field trips and badge-friendly programs in the hall and gardens, with structured activities and real learning outcomes.',
  },
];
---
<Base title="Retreats & Programs" description="Daytime corporate retreats, seminars, team workshops, and school programs in the functional program hall at Leaf & Lantern.">
  <Hero
    compact
    image="/images/courtyard-summer.png"
    imageAlt="Guests gathered at wood tables in the courtyard beside the main hall"
    imageLabel="The Courtyard"
    eyebrow="Retreats & Programs"
    title="A working space that happens to be beautiful."
    copy="One functional hall for retreats, seminars, workshops, and school programs — daytime, purposeful, and catered by our own counter."
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Purposeful Programs</span>
        <h2>What the hall is for</h2>
        <p class="lede">
          Programs book weekday daytime blocks and scheduled closed days, so public hours are
          never displaced — and your group gets the place at its calmest.
        </p>
      </div>
      <div class="pkg-grid">
        {programs.map((p) => (
          <div class="pkg-card">
            <h3>{p.name}</h3>
            <p class="pkg-price">{p.price}</p>
            <p>{p.copy}</p>
          </div>
        ))}
      </div>
      <p class="no-events-note">
        One thing we don’t do: weddings, showers, or receptions. The hall is a program space, not
        an event venue — that focus is what keeps it available, affordable, and calm.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container split">
      <BrandImage
        src="/images/yoga-morning.jpg"
        alt="The main hall in an open, flexible configuration with morning light"
        ratio="4 / 3"
      />
      <div>
        <span class="eyebrow">The Space</span>
        <h2>One hall, many configurations.</h2>
        <p>
          The hall converts between workshop, classroom, presentation, and long-table layouts.
          Timber structure, natural light, a visible donut line, and a protected courtyard — with
          coffee, cider, and donuts from our own counter all day.
        </p>
        <ul class="amenities">
          <li>Workshop and classroom seating for up to 80</li>
          <li>Coffee, cider, and donut service from our counter</li>
          <li>Audio for presentations and acoustic music</li>
          <li>Accessible route throughout; free parking</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <span class="eyebrow">Start the Conversation</span>
      <h2>Tell us about your group</h2>
      <form class="inquiry-form" action="#" method="post">
        <div class="form-row">
          <div>
            <label for="rp-name">Your name</label>
            <input id="rp-name" type="text" name="name" required />
          </div>
          <div>
            <label for="rp-email">Email</label>
            <input id="rp-email" type="email" name="email" required />
          </div>
        </div>
        <div class="form-row">
          <div>
            <label for="rp-type">Program type</label>
            <select id="rp-type" name="type">
              <option>Corporate retreat or seminar</option>
              <option>Team workshop</option>
              <option>School or scout group</option>
              <option>Other</option>
            </select>
          </div>
          <div>
            <label for="rp-size">Estimated attendees</label>
            <input id="rp-size" type="text" name="size" placeholder="e.g. 30" />
          </div>
        </div>
        <label for="rp-notes">Anything else?</label>
        <textarea id="rp-notes" name="notes" rows="4" placeholder="Season, weekday preference, and what your group needs…"></textarea>
        <button class="btn btn-primary" type="submit">Submit Inquiry</button>
        <small>Bookings open with our pilot season — this form is a preview.</small>
      </form>
    </div>
  </section>
</Base>

<style>
  .section-head {
    max-width: 52em;
    margin-bottom: 2.2rem;
  }

  .pkg-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .pkg-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.8rem 1.7rem;
  }

  .pkg-price {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--cider);
    margin-bottom: 0.6rem;
  }

  .pkg-card p:last-child {
    margin: 0;
    font-size: 0.96rem;
  }

  .no-events-note {
    margin-top: 1.6rem;
    padding: 1rem 1.2rem;
    background: var(--cider-soft);
    border-radius: var(--radius);
    font-size: 0.95rem;
    max-width: 52em;
  }

  .split {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .amenities {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 0.45rem;
  }

  .amenities li {
    padding-left: 1.4rem;
    position: relative;
  }

  .amenities li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cider);
  }

  .inquiry-form {
    margin-top: 1.4rem;
    display: grid;
    gap: 1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .inquiry-form .btn {
    justify-self: start;
  }

  .inquiry-form small {
    opacity: 0.65;
  }

  @media (max-width: 900px) {
    .pkg-grid,
    .split,
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
