---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import BrandImage from '../components/BrandImage.astro';

const programs = [
  {
    name: 'School Field Trips',
    detail: '$12–$16 per student · minimum group charge',
    copy: 'Fixed packages with clear grade bands, learning objectives mapped to Michigan academic standards, teacher materials, bus arrival instructions, indoor rain plans, and optional lunch or take-home kits.',
  },
  {
    name: 'Homeschool Days',
    detail: 'Select weekdays, spring & fall',
    copy: 'Structured multi-age programming on quieter weekdays — soil, seeds, pollinators, weather, and seasonal food systems, with room for families to explore together.',
  },
  {
    name: 'Summer Science & Nature Camps',
    detail: '$285–$425 per child per week',
    copy: 'Small cohorts of sixteen to twenty-four campers keep the experience attentive. Hands-on stations with leaves, insects, soil, water, magnifiers, weather tools, and garden samples.',
  },
  {
    name: 'Family Discovery Days',
    detail: '$8–$12 per guest',
    copy: 'Weekend programs where children and adults learn side by side — seed starting, garden mapping, habitat building, and nature walks through the grounds.',
  },
];
---
<Base title="Schools & Camps" description="Curriculum-mapped field trips, homeschool days, and small summer science camps at Leaf & Lantern.">
  <Hero
    compact
    image="/images/learning-hall.jpg"
    imageAlt="Children at hands-on science stations inside the timber teaching hall"
    eyebrow="Schools & Camps"
    title="Real learning, outdoors and in."
    copy="Programs are active rather than theatrical — children test, observe, compare, map, and build."
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Spring is for Discovery</span>
        <h2>Programs for schools and families</h2>
        <p class="lede">
          Every program is explicitly mapped to science, environment, agriculture, art, and
          observation standards — not marketed as a generic field trip.
        </p>
      </div>
      <div class="program-grid">
        {programs.map((p) => (
          <div class="program-card">
            <h3>{p.name}</h3>
            <p class="program-detail">{p.detail}</p>
            <p>{p.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container split">
      <div>
        <span class="eyebrow">For Educators</span>
        <h2>Request a program</h2>
        <p>
          Tell us about your group and we’ll follow up with dates, pricing, and program guides.
          Booking opens ahead of each season — educators on our list hear first.
        </p>
        <form class="inquiry-form" action="#" method="post">
          <div class="form-row">
            <div>
              <label for="sc-name">Your name</label>
              <input id="sc-name" type="text" name="name" required />
            </div>
            <div>
              <label for="sc-email">Email</label>
              <input id="sc-email" type="email" name="email" required />
            </div>
          </div>
          <div class="form-row">
            <div>
              <label for="sc-org">School or organization</label>
              <input id="sc-org" type="text" name="organization" />
            </div>
            <div>
              <label for="sc-type">Program type</label>
              <select id="sc-type" name="program">
                <option>School field trip</option>
                <option>Homeschool day</option>
                <option>Summer camp</option>
                <option>Family discovery day</option>
              </select>
            </div>
          </div>
          <label for="sc-notes">Tell us about your group</label>
          <textarea id="sc-notes" name="notes" rows="4" placeholder="Grade level, group size, season you have in mind…"></textarea>
          <button class="btn btn-primary" type="submit">Send Inquiry</button>
          <small>Inquiries open with our pilot season — this form is a preview.</small>
        </form>
      </div>
      <BrandImage
        src="/images/spring-discovery.png"
        alt="Children testing soil and examining seedlings in the spring gardens"
        label="Spring Discovery"
        ratio="3 / 4"
      />
    </div>
  </section>
</Base>

<style>
  .section-head {
    max-width: 52em;
    margin-bottom: 2.2rem;
  }

  .program-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }

  .program-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.8rem 1.7rem;
  }

  .program-card h3 {
    margin-bottom: 0.2rem;
  }

  .program-detail {
    font-weight: 700;
    color: var(--cider);
    font-size: 0.92rem;
    margin-bottom: 0.7rem;
  }

  .program-card p:last-child {
    margin: 0;
  }

  .split {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .inquiry-form {
    margin-top: 1.4rem;
    display: grid;
    gap: 1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .inquiry-form label {
    margin-bottom: 0.3rem;
  }

  .inquiry-form .btn {
    justify-self: start;
  }

  .inquiry-form small {
    opacity: 0.65;
  }

  @media (max-width: 900px) {
    .program-grid,
    .split,
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
