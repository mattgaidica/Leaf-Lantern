---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import BrandImage from '../components/BrandImage.astro';
import { url } from '../lib/site';

const categories = [
  { name: 'Ceramics & Tableware', copy: 'Mugs, serving pieces, and everyday tableware from Michigan potters.' },
  { name: 'Textiles & Wool', copy: 'Blankets, mittens, hats, and woven goods made for real winters.' },
  { name: 'Pantry & Preserves', copy: 'Honey, jams, syrups, and Leaf & Lantern pantry products.' },
  { name: 'Wood & Home', copy: 'Cutting boards, utensils, and small furniture from local woodworkers.' },
  { name: 'Candles & Botanicals', copy: 'Hand-poured candles, dried florals, and seasonal greenery.' },
  { name: 'Paper & Children’s Gifts', copy: 'Cards, prints, ornaments, and thoughtfully made toys.' },
];
---
<Base title="The Market" description="The Market at Leaf & Lantern: a visible donut line, fresh cider, a short coffee menu, and curated goods from Michigan makers.">
  <Hero
    compact
    image="/images/gift-market.jpg"
    imageAlt="Curated maker displays under warm lantern light in the market hall"
    eyebrow="The Market & Counter"
    title="Made nearby. Chosen with care."
    copy="Useful, beautiful, and delicious goods from Michigan makers and producers — alongside the best cider, donuts, and coffee around."
  />

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">The Counter</span>
        <h2>No complicated menu. Just the things we think should be done exceptionally well.</h2>
        <p class="lede">
          We’re not a bakery with seventeen pastries — we make a few hero products consistently:
          hot donuts, fresh cider, a $2 Morning Cup, and a handful of warm drinks. No sizes, no
          syrups, no “grande.” Follow the smell of cinnamon to the counter and watch the donuts
          made — and yes, there’s a donut for the dog.
        </p>
        <p>
          Separate order and pickup lines keep things moving even on peak weekends — or order
          before you arrive, choose a kitchen pickup window, and collect at the dedicated pickup
          counter on the same prices as walk-up. Ordering ahead helps the kitchen; it never
          reserves a spot on the grounds and never creates a second price path.
        </p>
        <a class="btn btn-primary" href={url('/order/')}>Order Ahead & Skip the Line</a>
      </div>
      <BrandImage
        src="/images/cider-donuts-closeup.png"
        alt="Cinnamon donuts, cider, and coffee on a wood table by the counter"
        label="Cider & Donuts"
        ratio="3 / 4"
      />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Curated, Not Crowded</span>
        <h2>What you’ll find in the Market</h2>
        <p class="lede">
          Makers and products are selected for quality, utility, and fit — a small general store
          and artisan hall, not a souvenir shop. The mix changes with the seasons.
        </p>
      </div>
      <div class="cat-grid">
        {categories.map((cat) => (
          <div class="cat-card">
            <h3>{cat.name}</h3>
            <p>{cat.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split split-reverse">
      <BrandImage
        src="/images/learning-hall.jpg"
        alt="The main hall configured as a warm market space with maker displays"
        ratio="4 / 3"
      />
      <div>
        <span class="eyebrow">For Makers</span>
        <h2>Sell where your work is understood.</h2>
        <p class="lede">
          Our juried spring, autumn, and holiday markets pair fair booth fees with an audience
          that values handmade work — and booth counts limited by visual quality, not maximized
          for volume.
        </p>
        <a class="btn btn-secondary" href={url('/makers/')}>Vendor Standards & Applications</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container split">
      <div>
        <span class="eyebrow">Signature Goods</span>
        <h2>A few things of our own.</h2>
        <p class="lede">
          Alongside the makers, the Market carries a short line of Leaf & Lantern signature
          goods — beginning with a few heavyweight sweatshirts designed with the same
          philosophy as the menu: a handful of things, done exceptionally well.
        </p>
        <p>
          No slogan racks, no wall of souvenirs. A few timeless designs each year, produced in
          limited runs and made to be worn long after the visit — and never so much of our own
          product that it crowds out the makers the Market exists to showcase. When a design
          sells through, it may simply be gone until next season.
        </p>
      </div>
      <BrandImage
        src="/images/signature-sweatshirts.png"
        alt="Three Leaf & Lantern signature sweatshirts — Autumn Is Calling, Cider Weather, and Good Things Come in Dozens — folded on a wood table in the Market"
        label="Signature Sweatshirts"
        ratio="4 / 3"
      />
    </div>
  </section>
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .split-reverse {
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
  }

  .section-head {
    max-width: 52em;
    margin-bottom: 2.2rem;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
  }

  .cat-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.6rem 1.5rem;
  }

  .cat-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .cat-card p {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .split,
    .split-reverse {
      grid-template-columns: 1fr;
    }

    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
